<!--
[1] WM 1 June content changes from Gigacomm
[2] WM 1 June content changes from Gigacomm
[3] CL 9 Captures IP Address
[4] CL - 17-June-25 - Update Lead Source
-->
<aura:component implements="force:hasRecordId,forceCommunity:availableForAllPageTypes" controller="GigacommCommunityPlanController">
    <aura:attribute name="lead" type="Lead" default="{'FirstName' : ''}" />
    <aura:attribute name="tc" type="SObject"/>	
    <aura:attribute name="stateOptions" type="String[]"/>
    <aura:attribute name="showPersonalDetails" type="Boolean" default="true" />
    <aura:attribute name="showReview" type="Boolean"/>
    <aura:attribute name="showAgreement" type="Boolean"/>
    <aura:attribute name="showAcknowledgement" type="Boolean"/>    
    <aura:attribute name="ipAddress" type="String" />
    <aura:handler name="init" value="{!this}" action="c.doInit"/>
    <div class="container  slds-p-bottom_large">
        <div class="slds-grid slds-wrap slds-m-top_xx-large slds-m-bottom_xx-large">
            <div class="slds-col slds-large-size_2-of-12 slds-small-size_12-of-12 ">
                
            </div>
            <div class="slds-col slds-large-size_8-of-12 slds-small-size_12-of-12">
                <div class=" slds-text-align_center">
                    <h1 class="gc-order-wizard-section-title gc-default-color slds-m-bottom_large ">
                        Community Plan
                    </h1>
                    
                    <span class="gc-order-wizard-nav ">
                        <button class="nav-link-active">
                            <strong>Monthly</strong>
                        </button>
                    </span>
                </div>
                <div class="gc-community-plan-container slds-m-top_xx-large">
                    <div class="slds-grid slds-wrap slds-grid_vertical-stretch">
                        
                        
                        <div class="slds-col slds-large-size_9-of-12 slds-small-size_12-of-12 slds-m-bottom_small slds-p-around_large ">
                            
                            <div class="gc-default-color">
                                <h3>Community 100</h3>
                            </div>
                            
                            <div class="gc-plan-rate">
                                <span class="value">100</span>
                                <div>
                                    <span class="unit">Mbps</span>
                                    <span class="label">Download</span>
                                </div>
                                <span class="slds-border_left slds-p-bottom_xx-small slds-p-top_xx-small slds-m-left_x-small slds-p-right_xx-small">&nbsp;</span>
                                <span class="value ">100</span>
                                <div>
                                    <span class="unit">Mbps</span>
                                    <span class="label">Upload</span>
                                </div>
                            </div>
                            
                            <div class="gc-order-wizard-rate slds-m-top_small slds-m-bottom_medium">
                                <span class="gc-order-wizard-rate-amount ">
                                    $49
                                </span>
                                
                                <div class="gc-order-wizard-rate-speed slds-p-right_small ">
                                    <p id="">&nbsp;</p>
                                    <p id="">per month</p>
                                </div>
                                
                                
                                
                                
                            </div>
                            
                            
                            <!-- [2] <p>GigaComm’s Community plan is an internet service delivered only to government-subsidised, short- and long-term tenants.</p> -->
                            <p> Gigacomm’s Community plan is an internet service delivered only to government-subsidised, short- and long-term tenants within our network.</p> 
                            <p class="gc-community-benefits"><img class="gc-community-benefits-icon" src="{!$Resource.GigacommCommunityPageAsset + '/currency.svg'}"/> $0 installation fee</p>
                            <p class="gc-community-benefits"><img class="gc-community-benefits-icon" src="{!$Resource.GigacommCommunityPageAsset + '/freeRouter.svg'}"/> Free router</p>
                            <p class="gc-community-benefits"><img class="gc-community-benefits-icon" src="{!$Resource.GigacommCommunityPageAsset + '/lockin.svg'}"/> No lock-in contract</p>
                            
                            <p class="gc-community-footer-text slds-m-top_large">Paid monthly basis via Direct Debit OR fortnightly basis via Centrepay deductions</p>
                            <p class="gc-community-footer-text">Payment by Centrepay only applicable to certain Centrelink benefits</p>
                            
                            <button class="gc-btn slds-m-top_medium" data-bs-toggle="collapse" data-bs-target="#gigacommCommunityPlan" >Connect Now</button>
                            
                        </div>
                        
                        
                        <div class="slds-col slds-large-size_3-of-12 slds-small-size_12-of-12 " >
                            <div style="{! 'background-image: url(\'' + $Resource.GigacommCommunityPageAsset + '/PlanImg.png' + '\')'}" class="gc-community-plan-img"></div>
                        </div>
                        
                        
                    </div>
                    
                </div>
                
                <div class="slds-text-align_center">
                    <p><br/>&nbsp;<br/>For enquiries email us at community@gigacomm.net.au or call 1300 004 442.</p>
                    
                    <p>For further information about Centrepay please click here: <a href="https://servicesaustralia.gov.au/centrepay" target="_blank">servicesaustralia.gov.au/centrepay</a></p>
                </div>
            </div>
            
            <div class="slds-col slds-large-size_2-of-12 slds-small-size_12-of-12" >
                
                
                
            </div>
            
        </div>
        
        
        
        <div class="slds-grid slds-wrap slds-gutters slds-gutters_large slds-m-top_xx-large slds-m-bottom_large slds-p-around_x-small">
            <div class="slds-col slds-large-size_5-of-12 slds-small-size_12-of-12 slds-m-top_large slds-m-bottom_small">
                <img src="{!$Resource.GigacommCommunityPageAsset + '/ConnectingASustainableFuture.jpg'}" class="img-fluid gc-img-rounded"/>
            </div>
            
            <div class="slds-col slds-large-size_7-of-12 slds-small-size_12-of-12 slds-m-top_large slds-m-bottom_small gc-community-container">
                <h1 class="gc-order-wizard-section-title gc-default-color">
                    Connecting a sustainable future 
                </h1>
                
                <p>By seizing the opportunity to create shared value with Community Housing Providers, Government and wider industry Partners, 
                    we can provide a cost-effective and reliable internet service that meets the needs of residents living in community housing. Together, we can transform this vision into reality, 
                    ensuring that our approach not only benefits our partners but also delivers significant value to the broader community.
                </p>
                <p>
                    Contact us today for more information on connecting community housing buildings.      
                </p>
                
                <button class="gc-btn" data-bs-toggle="collapse" data-bs-target="#gigacommContactUs">Get in Touch</button>
            </div>
            
        </div>
        
    </div>
    
    <div class="collapse" id="gigacommContactUs">
        <c:GigaCommContactUs leadSource="Website Community" stateOptions="{!v.stateOptions}" title="Contact Us" />
    </div>
    
    
    <div class="collapse" id="gigacommCommunityPlan">
        <section role="dialog" tabindex="-2" aria-modal="true" aria-labelledby="modal-heading-01" class="slds-modal slds-fade-in-open slds-modal_small ">
            <div class="slds-modal__container">
                
                <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                    
                    
                    <div class="slds-grid slds-wrap">
                        <div class="slds-col slds-size_6-of-12">
                        </div>
                        <div class="slds-col slds-size_6-of-12 slds-text-align_right">
                            <!-- data-bs-target="#collapseRegisterAddress"-->
                            <button class="slds-button slds-button_icon slds-modal__close" data-bs-toggle="collapse" data-bs-target="#gigacommCommunityPlan">   
                                <span class="material-symbols-outlined">
                                    close
                                </span>
                                <span class="slds-assistive-text">Cancel and close</span>
                            </button>
                            
                            
                        </div>
                    </div>
                    
                    <div class="container">
                        
                        
                        <div class="tab-content" id="myTabContent">
                            <aura:if isTrue="{!v.showPersonalDetails}">
                                <div class="" id="PersonalDetails" role="tabpanel" aria-labelledby="home-tab">
                                    <div class="slds-grid slds-wrap">
                                        <div class="slds-col slds-size-large_6-of-12 slds-size-small_6-of-12">
                                            <p class="gc-p-2 gc-default-color"><strong>Personal Details</strong></p>
                                        </div>
                                        
                                        <div class="slds-col slds-size-large_6-of-12 slds-size-small_6-of-12">
                                            <div class="logoContainer gc-community-logoContainer"></div>
                                        </div>
                                        
                                    </div>
                                    
                                    <div class="slds-grid slds-wrap slds-gutters slds-p-bottom_large">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_6-of-12">
                                            <lightning:input aura:id="addressField" name="FirstName" required="true" class="gc-pd-input-text" label="First Name" placeholder="Enter First name" value="{!v.lead.FirstName}"  />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_6-of-12">
                                            <lightning:input aura:id="addressField" name="LastName" required="true" class="gc-pd-input-text" label="Last Name" placeholder="Enter Last name" value="{!v.lead.LastName}"  />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <lightning:input aura:id="addressField" name="email" required="true" type="email"  class="gc-pd-input-text slds-border-around_none" label="Email" value="{!v.lead.Email}"  placeholder="Enter Email" />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <lightning:input aura:id="addressField" name="phoneNumber" required="true" class="gc-pd-input-text" label="Phone Number" placeholder="Enter Phone Number" value="{!v.lead.MobilePhone}" />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <lightning:input aura:id="addressField" name="streetAddress" required="true" class="gc-pd-input-text" label="Street Address" placeholder="Enter Street Address" value="{!v.lead.Street}" />
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_6-of-12">
                                            <lightning:input aura:id="addressField" name="City" required="true" class="gc-pd-input-text" label="City" placeholder="Enter City" value="{!v.lead.City}"  />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_6-of-12">
                                            
                                            
                                            <lightning:select aura:id="stateField" name="stateField" 
                                                              class="gc-select-input gc-pd-input-text " label="State/Region" required="true" value="{!v.lead.StateCode}">
                                                
                                                <aura:iteration items="{!v.stateOptions}" var="item">
                                                    <aura:if isTrue="{!item.value == ''}">
                                                        <option disabled="true" selected="selected" value="{!item.value}">{!item.label}</option>
                                                        <aura:set attribute="else">
                                                            <option value="{!item.value}">{!item.label}</option>
                                                        </aura:set>
                                                    </aura:if>
                                                </aura:iteration>
                                            </lightning:select>
                                            
                                            
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12 slds-m-top_x-large">
                                            <button class="gc-btn gc-community-btn-right" value="rv" onclick="{!c.next}">
                                                Next
                                            </button>
                                        </div>
                                        
                                    </div>
                                    
                                    
                                </div>
                            </aura:if>
                            <aura:if isTrue="{!v.showReview}">
                                <div class="" id="Review" role="tabpanel" aria-labelledby="home-tab">
                                    <div class="slds-grid slds-wrap">
                                        <div class="slds-col slds-size-large_6-of-12 slds-size-small_6-of-12">
                                            <p class="gc-p-2 gc-default-color"><strong>Review</strong></p>
                                        </div>
                                        <div class="slds-col slds-size-large_6-of-12 slds-size-small_6-of-12">
                                            <div class="logoContainer gc-community-logoContainer"></div>
                                        </div>
                                        
                                    </div>
                                    
                                    <div class="slds-grid slds-wrap slds-gutters">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <p>Review your order before placing it below. Plan Details</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>FTTx Community 100 (100/100Mbps)</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">$49.00</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>FTTx FTTx Installation</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">$125.00</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>Gigacomm Supplied Router</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">$119.00</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>Contract</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">Monthly</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>• Offer: 100% off FTTx Install</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">(-$125.00)</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>• Offer: 100% off Router</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">(-$119.00)</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>Total One-Off Costs</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">$0.00</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_9-of-12 slds-large-size_9-of-12">
                                            <p>Total Monthly Fees (first month)</p>
                                        </div>
                                        
                                        <div class="slds-col slds-small-size_3-of-12 slds-large-size_3-of-12 slds-text-align_right">
                                            <p class="slds-p-right_small">$49.00</p>
                                        </div>
                                        
                                    </div>
                                    
                                    
                                    <div class="slds-grid slds-wrap">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12 slds-p-top_medium">
                                            <button class="gc-btn" value="pd" onclick="{!c.next}">
                                                Previous
                                            </button>
                                            <button class="gc-btn gc-community-btn-right" value="at" onclick="{!c.next}">
                                                Next
                                            </button>
                                        </div>                                
                                    </div>
                                    
                                    
                                    
                                    
                                </div>
                            </aura:if>
                            
                            <aura:if isTrue="{!v.showAgreement}">
                                <div class="" id="Agreement" role="tabpanel" aria-labelledby="home-tab">
                                    <div class="slds-grid slds-wrap">
                                        <div class="slds-col slds-size-large_12-of-12 slds-size-small_12-of-12">
                                            <p class="gc-p-2 gc-default-color"><strong>Agreement &amp; Acceptance</strong></p>
                                        </div>
                                        <div class="slds-col slds-size-large_6-of-12 slds-size-small_6-of-12">
                                            <div class="logoContainer gc-community-logoContainer"></div>
                                        </div>
                                        
                                    </div>
                                    
                                    <div class="slds-grid slds-wrap slds-gutters">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <p>Community Agreement Terms<span class="gc-color-red">*</span></p>
                                        </div>
                                        
                                        <!--div class="slds-col slds-small-size_12-of-12 slds-large-size_12-of-12">
                                            <div class="slds-form-element__control slds-grow">
                                                <span class="slds-checkbox" part="input-checkbox">
                                                    <input type="checkbox" checked="{!v.tc.tc1}" onchange="{!c.checkTC}" part="checkbox" aura:id="gcCheckBox" required="true" id="checkbox1" name="input1"/>
                                                    
                                                    <label class="slds-checkbox__label" for="checkbox1" part="label-container">
                                                        <span part="indicator" class="slds-checkbox_faux"></span>
                                                        <span class="slds-form-element__label" part="label">
                                                            <span class="gc-color-red">*</span>&nbsp;I agree that GigaComm's standard form of agreement, 
                                                            the offer terms set out above and the critical information summary for my plan, form my agreement with GigaComm.
                                                            
                                                        </span>
                                                    </label>
                                                </span>
                                            </div>
                                        </div-->
                                        
                                        <div class="slds-col slds-small-size_12-of-12 slds-large-size_12-of-12">
                                            <div class="slds-form-element__control slds-grow">
                                                <span class="slds-checkbox" part="input-checkbox">
                                                    <input type="checkbox" checked="{!v.tc.tc2}" onchange="{!c.checkTC2}" part="checkbox" aura:id="gcCheckBox" required="true" id="checkbox-2" name="input2"/>
                                                    
                                                    <label class="slds-checkbox__label" for="checkbox-2" part="label-container">
                                                        <span part="indicator" class="slds-checkbox_faux"></span>
                                                        <span class="slds-form-element__label" part="label">
                                                            <span class="gc-color-red">*</span> &nbsp;I acknowledge that I have read and agree to the terms set out in the 
                                                            <a href="{!$Resource.GigaCommSFOA}" target="_blank">standard form of agreement</a>, 
                                                            the offer terms set out above and the <a href="critical-information-summaries" target="_blank">
                                                            critical information summary</a> for my plan.
                                                        </span>
                                                    </label>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="slds-col slds-small-size_12-of-12 slds-large-size_12-of-12">
                                            <p class="slds-m-top_medium gc-community-tc">Gigacomm.net.au needs the contact information you provide to us to contact you about our products and services. 
                                                You may unsubscribe from these communications at anytime. For information on how to unsubscribe, 
                                                as well as our privacy practices and commitment to protecting your privacy, check out our Privacy Policy.</p>
                                        </div>
                                        
                                        
                                    </div>
                                    
                                    <div class="slds-grid slds-wrap">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12 slds-p-top_medium">
                                            <button class="gc-btn" value="rvv" onclick="{!c.next}">
                                                Previous
                                            </button>
                                            <aura:if isTrue="{!AND(v.tc.tc2)}">
                                                <button class="gc-btn gc-community-btn-right" value="at" onclick="{!c.save}">
                                                    Submit
                                                </button>
                                                <aura:set attribute="else">
                                                    <button class="gc-btn gc-community-btn-right gc-btn-disabled"  disabled="true">
                                                        Submit
                                                    </button>
                                                </aura:set>
                                                
                                            </aura:if>
                                        </div>                                
                                    </div>
                                    
                                </div>
                            </aura:if>
                            
                            
                            <aura:if isTrue="{!v.showAcknowledgement}">
                                <div class="slds-grid slds-wrap">
                                    <div class="slds-col slds-size-large_12-of-12 slds-size-small_6-of-12">
                                        <p class="gc-p-2 gc-default-color"><strong>Order Placed</strong></p>
                                    </div>
                                    <div class="slds-col slds-size-large_6-of-12 slds-size-small_6-of-12">
                                        <div class="logoContainer gc-community-logoContainer"></div>
                                    </div>
                                    
                                </div>
                                
                                <div class="slds-grid slds-wrap">
                                    <div class="slds-col slds-size-large_12-of-12 slds-size-small_12-of-12">
                                        <p>Thank you for connecting to GigaComm Community. We'll be in touch soon. </p>
                                        
                                        <p><a href="https://www.gigacomm.net.au/hubfs/Community/CentrePay%20Deduction%20Authority.pdf" target="_blank">Click here to setup automatic bill payment via Centrepay.</a> </p>
                                    </div>
                                    
                                    
                                </div>
                                
                            </aura:if>
                            
                        </div>
                    </div>  
                    
                </div>
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open" role="presentation"></div>
    </div>
</aura:component>