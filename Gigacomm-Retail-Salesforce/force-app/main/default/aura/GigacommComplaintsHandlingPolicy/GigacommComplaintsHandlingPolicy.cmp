    <div class="container slds-m-top_xx-large">
        <div class="slds-grid slds-wrap gc-border gc-success-container slds-p-around_x-large">
            <div class="slds-col slds-size-large_12-of-12 slds-size-small_12-of-12">
                
                <h5 class="slds-m-top_medium gc-default-color slds-m-top_medium slds-m-bottom_medium">Complaints Handling Policy</h5>
                <div class="slds-grid slds-wrap">
                    <div class="slds-col slds-size-large_6-of-12 slds-size-small_12-of-12">
                        
                        <!--  <p class=""> <img class="" src="{!$Resource.GigaCommAsset + '/PaymentSuccessful/check.svg'}" />
                            
                            Your order details have been emailed to you
