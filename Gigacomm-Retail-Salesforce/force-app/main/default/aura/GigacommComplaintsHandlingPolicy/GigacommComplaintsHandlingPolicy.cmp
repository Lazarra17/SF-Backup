            <h5 class="gc-heading-title slds-m-top_medium">COMPLAINTS HANDLING POLICY</h5>
            <!--p class="gc-success-text">Lorem ipsum is simply dummy text of the printing and industry</p-->
            <p></p>
            <!--<p class="gc-color-white">Thank you for your order! Get ready for faster speeds, better value and reliable internet.</p> -->
