            <div class="gc-business-plan-container slds-p-left_large slds-p-right_large  slds-p-bottom_x-large  slds-p-top_none">
                <div class="gc-business-title gc-default-color"><p class="slds-text-align_center slds-p-top_xx-small slds-p-bottom_xx-small">Business 250</p></div>
