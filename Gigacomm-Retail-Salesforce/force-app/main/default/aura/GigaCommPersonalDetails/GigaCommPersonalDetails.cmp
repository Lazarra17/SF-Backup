<!-- 
[1] WM 20 May 2025 - fix hyperlinks

[2] WM 27 May 2025 - change Click here to review our Terms and Conditions To: IMPORTANT Click here to review our T&Cs"

[3] WM 28 May 2025 - on mobile, change breadcrumb "Personal Details" to "Details'
[4] JPS 31 May 2025 - Add boolean var to check if lead detail has been validated
[5] JPS 31 May 2025 - Update conditional logic to enable "Place Order" button
[6] JPS 31 May 2025 - Add boolean var and onclick function to Accept T&Cs button
[7] CL 6 Jun 2025 - Fix mobile TC Button
[8] CL 9 Jun 2025 - Capture T&C and Marketing Fields
[9] CL 24 Jun 2025 - Voucher Feature
[10] CL 1 Aug 2025 - Mobile Number must be 10 digits
-->

<aura:component  implements="force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" controller="GigaCommOrderPersonalDetailsController">
    
    <aura:attribute name="lead" type="Object"/>
    <aura:attribute name="eziDebit" type="Object"/>
    <aura:attribute name="showSpinner" type="Boolean"/>
    <aura:attribute name="tc" type="Object"/>	
    <aura:attribute name="acceptedTC" type="Boolean" default="false"/>
    <aura:attribute name="enableBtn" type="Boolean" default="false"/>
    <aura:attribute name="showTCMobile" type="Boolean" default="false"/>
    <aura:attribute name="confirmedDetails" type="Boolean" default="false"/>
    <aura:handler name="init" value="{!this}" action="c.doInit"/>
	<aura:attribute name="apiHasError" type="Boolean" />
    <aura:attribute name="showPromoModal" type="Boolean" />
    <aura:attribute name="promoCode" type="String" />
    <aura:attribute name="detailsValidated" type="Boolean" default="false"/> <!-- [4] JPS 31 May 2025 - Add boolean var to check if lead detail has been confirmed -->
    
    <div class="slds-grid slds-wrap">
        <div class="slds-col slds-size_12-of-12 gc-plans-heading">
            <div onclick="{!c.navigateToPlans}" class="gc-pd-back">
                <img class="gc-location" src="{!$Resource.GigaCommAsset + '/SelectPlanPageIcons/Backarrow1.svg'}"  /> 
                <span class="gc-heading-back">Back</span>
            </div>
            <h2 class="gc-heading-title slds-m-top_large">{!$Label.c.GigacommPersonalDetail_THE_FREEDOM_TO_DO_MORE}</h2>
            <!-- <h2 class="gc-heading-title">on 12-month sign-ups</h2> -->
            <p class="gc-white-text-color">{!$Label.c.GigacommPersonalDetail_It_s_the_internet_Australia_both_needs_and_deserves}</p>
        </div>
    </div>
    
    <!--Desktop Version-->
    <div class="slds-grid slds-wrap slds-show_small slds-m-top_medium slds-border_bottom slds-p-bottom_medium">
        <div class="slds-col slds-size-large_3-of-12 slds-size-small_12-of-12 ">
        </div>
        <div class="slds-col slds-size-large_6-of-12 slds-size-small_12-of-12 ">
            <div class="gc-breadcrumbs-row">
                <div class="gc-breadcrumbs-text gc-default-color">
                    <strong>
                        <img class="gc-badge gc-badge-done" src="{!$Resource.GigaCommAsset + '/SelectYourPlanWithImage/check.svg'}" /> Plans &amp; Add-ons
                    </strong>
                </div>
                <div class="gc-breadcrumbs-line"></div>
                <div class="gc-breadcrumbs-text"><strong><span class="gc-badge gc-badge-current">2</span>Personal Details</strong></div>
                <div class="gc-breadcrumbs-line"></div>
                <div class="gc-breadcrumbs-text"><strong><span class="gc-badge gc-badge-neutral">3</span>Payment</strong></div>
            </div>
        </div>
        <div class="slds-col slds-size-large_3-of-12 slds-size-small_12-of-12 ">
        </div>
    </div>
    
    <!--Mobile Version START-->
    <div class="slds-grid slds-hide_small slds-wrap slds-m-top_medium">
        <div class="slds-col slds-size-large_12-of-12 slds-size-small_12-of-12 ">
            <div class="gc-breadcrumbs-row">
                <div class="gc-breadcrumbs-text slds-p-left_large">
                    <strong>
                        <img class="gc-badge gc-badge-done" src="{!$Resource.GigaCommAsset + '/SelectYourPlanWithImage/check.svg'}" /> 
                    </strong>
                </div>
                <div class="gc-breadcrumbs-line"></div>
                <div class="gc-breadcrumbs-text"><strong><span class="gc-badge gc-badge-neutral gc-badge-current">2</span></strong>
                </div>
                <div class="gc-breadcrumbs-line"></div>
                <div class="gc-breadcrumbs-text slds-p-right_large"><strong><span class="gc-badge gc-badge-neutral">3</span></strong>
                </div>
            </div>
        </div>
        
    </div>
    <div class="slds-grid slds-hide_small slds-wrap">
        <div class="slds-col slds-size-large_12-of-12 slds-size-small_12-of-12 ">
            <div class="gc-breadcrumbs-row">
                <div class="gc-breadcrumbs-text"><strong><p class="slds-text-align_center">Plans &amp; Add-ons</p></strong>
                </div>
                <div class="gc-breadcrumbs-space"></div>
                <div class="gc-breadcrumbs-text"><strong><p class="slds-text-align_center">Details</p></strong> <!-- [3] -->
                </div>
                <div class="gc-breadcrumbs-space"></div>
                <div class="gc-breadcrumbs-text slds-p-right_small"><strong><p class="slds-text-align_center">Payment</p></strong>
                </div>
            </div>
        </div>
    </div>
    
    
    <div class="container">
        <div class="slds-grid slds-gutters slds-wrap slds-m-top_xx-large slds-p-top_x-large">
            <div class="slds-col slds-large-size_8-of-12 slds-small-size_12-of-12 ">
                
                
                <div class="accordion" id="PersonalDetails">
                    <div class="accordion-item">
                        <p class="accordion-header">
                            
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                <p class="gc-pd-title">Personal Details</p>
                            </button>
                        </p>
                        <div id="collapseOne" class="accordion-collapse gc-accordion-pd-container collapse show" data-bs-parent="#PersonalDetails">
                            <div class="accordion-body">
                                
                                <div class="slds-grid slds-wrap">
                                    <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12 slds-m-top_small">
                                        <p class="gc-important-text"><img class="gc-icon-message" src="{!$Resource.GigaCommAsset + '/SelectYourPlanWithImage/Messege.svg'}" /><strong>Important!</strong> Please ensure unit number is correct so our technicians connect the right unit<span class="gc-color-red">*</span></p>
                                    </div>
                                </div>
                                <!--form aura:id="orderForm" action="/giga/s/finalising-order" method="POST"-->
                                    <div class="slds-grid slds-wrap slds-gutters slds-p-around_small">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_6-of-12">
                                            <input name="leadId" class="gc-pd-input-text slds-border-around_none" label="Lead Id" hidden="true" value="{!v.lead.Lead.Id}"/>
                                            <input name="state" class="gc-pd-input-text slds-border-around_none" label="StateCode" hidden="true" value="{!v.lead.Lead.StateCode}"/>
                                            <input name="postalCode" class="gc-pd-input-text slds-border-around_none" label="Postal Code" hidden="true" value="{!v.lead.Lead.PostalCode}"/>
                                            <input name="term" class="gc-pd-input-text slds-border-around_none" label="Term" hidden="true" value="{!v.lead.Lead.Term_bric__c}"/>
                                            <input name="planType" class="gc-pd-input-text slds-border-around_none" label="Plan Type" hidden="true" value="{!v.lead.PlanSelected.Product_bric__r.Download_Upload_Limit_bric__c}"/>
                                            <input name="hardwareIncluded" class="gc-pd-input-text slds-border-around_none" label="Hardware Included" hidden="true" value="{!v.lead.Router != null ? true : else}"/>
                                            <input name="planSelected" class="gc-pd-input-text slds-border-around_none" label="Plan Selected" hidden="true" value="{!v.lead.PlanSelected.Id}"/>
                                            
                                            <lightning:input aura:id="personDetailField" readonly="{!v.confirmedDetails}" name="UnitNumber" class="gc-pd-input-text slds-border-around_none" label="Unit Number"  placeholder="Enter unit number" value="{!v.lead.Lead.Unit_Number_Bric__c}"/>
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_3-of-12">
                                            <lightning:input aura:id="personDetailField" readonly="{!v.confirmedDetails}" name="FirstName" required="true" class="gc-pd-input-text" label="First Name" onchange="{!c.checkConfirmedDetails}" placeholder="Enter first name" value="{!v.lead.Lead.FirstName}"/>
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_3-of-12">
                                            <lightning:input aura:id="personDetailField" readonly="{!v.confirmedDetails}" name="LastName" required="true" class="gc-pd-input-text" label="Last Name" onchange="{!c.checkConfirmedDetails}" placeholder="Enter last name" value="{!v.lead.Lead.TECH_LastName_bric__c}"/>
                                        </div>
                                    </div>
                                    
                                    <div class="slds-grid slds-wrap slds-gutters slds-p-around_small">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_6-of-12">
                                            <lightning:input aura:id="personDetailField" readonly="{!v.confirmedDetails}" name="Email" required="true" type="email" class="gc-pd-input-text" label="Email" onchange="{!c.checkConfirmedDetails}" placeholder="Enter email" value="{!v.lead.Lead.Email}"/>
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_6-of-12">
                                            <lightning:input aura:id="personDetailField" readonly="{!v.confirmedDetails}" name="MobileNumber" required="true" type="tel" class="gc-pd-input-text" onchange="{!c.checkConfirmedDetails}" label="Mobile Number" maxlength="10"  minlength="10" messageWhenTooShort="Mobile number must be 10 digits." placeholder="Enter mobile number" value="{!v.lead.Lead.MobilePhone}"/>
                                        </div>
                                </div>
                                
                                
                                <div class="slds-grid slds-wrap slds-p-around_small">
                                    <div class="slds-col slds-small-size_12-of-12 slds-large-size_3-of-12">
                                    </div>
                                    <div class="slds-col slds-small-size_12-of-12 slds-large-size_6-of-12">
                                        <aura:if isTrue="{!v.confirmedDetails}">
                                            <button class="gc-btn-remove form-control" onclick="{!c.editDetails}">Edit Details</button>
                                       
                                            <aura:set attribute="else">
                                                 <button class="slds-button gc-check-eligibility-btn form-control" value="confirmDetails" onclick="{!c.validateForm}">Confirm Details</button>
                                            </aura:set>
                                        </aura:if>
                                        
                                    </div>
                                    <div class="slds-col slds-small-size_12-of-12 slds-large-size_3-of-12">
                                    </div>
                                </div>
                                
                                
                
                                
                                <!--/form-->
                            </div>
                        </div>
                    </div>
                    
                    <!--Promo Code-->
                    <div class="accordion slds-m-top_medium  slds-m-bottom_large" id="PromoCode">
                        <div class="accordion-item">
                            <p class="accordion-header">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="true" aria-controls="collapseOne">
                                    <p class="gc-pd-title">Promo Code</p>
                                </button>
                            </p>
                            <div id="collapseTwo" class="accordion-collapse gc-accordion-pd-container collapse show" data-bs-parent="#PromoCode">
                                <div class="accordion-body">
                                    
                                    <div class="slds-grid slds-wrap slds-gutters slds-p-top_medium slds-p-bottom_medium slds-p-left_small slds-p-right_small">
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_8-of-12">
                                            <lightning:input name="PromoCode" value="{!v.promoCode}" variant="label-hidden" class="gc-pd-input-text" label="" placeholder="Enter promo code"/>
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_4-of-12">
                                            
                                            <aura:if isTrue="{!AND(v.lead.isPromoCodeValid, v.lead.isPromoCodeValid != null)}">
                                                <div class="slds-col slds-small-size_1-of-1 slds-large-size_1-of-1">
                                                    <button class="gc-btn-remove form-control" onclick="{!c.removePromoCode}">Remove</button>
                                                </div>
                                                <aura:set attribute="else">
                                                    
                                                    <aura:if isTrue="{!AND(v.promoCode != null, v.promoCode != '')}">
                                                        <button class="btn gc-check-eligibility-btn form-control" onclick="{!c.checkPromoCode}">Apply</button>
                                                        <aura:set attribute="else">
                                                            <button class="btn gc-check-eligibility-btn gc-btn-disabled form-control" disabled="true">Apply</button>
                                                        </aura:set>
                                                    </aura:if>
                                                </aura:set>
                                                
                                            </aura:if>
                                            
                                            
                                            
                                        </div>
                                        
                                        <aura:if isTrue="{!AND(v.lead.isPromoCodeValid, v.lead.isPromoCodeValid != null)}">
                                            <div class="slds-col slds-small-size_1-of-1 slds-large-size_1-of-1">
                                                <p class="gc-promo-success slds-m-around_none"><span class="material-symbols-outlined gc-icon-check">check</span><span class="gc-promo-grats">Congrats! </span> Please see your order summary to see your discount that has been applied.</p>
                                          
                                                    <p class="gc-tc-p-6">{!v.lead.Voucher.Voucher_T_C__c}</p>
                                                                                               
                                            </div>
                                        </aura:if>
                                        <aura:if isTrue="{!AND(!v.lead.isPromoCodeValid, v.lead.isPromoCodeValid != null)}">
                                            <div class="slds-col slds-small-size_1-of-1 slds-large-size_1-of-1">
                                                <p class="gc-promo-success"><span class="material-symbols-outlined gc-icon-close">close</span><span class="gc-promo-grats"></span> {!v.lead.promoCodeMessage}</p>
                                            </div>
                                        </aura:if>
                                    </div>
                                    
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                
                <!--MOBILE TC-->
                <span aura:id="TCSection"></span>
                <aura:if isTrue="{!v.showTCMobile}">
                    <div class="slds-grid slds-wrap slds-hide_small">
                        <div class="slds-col slds-size_1-of-1 slds-p-top_large">
                            <div class="slds-grid slds-wrap gc-tc-container "> 
                                <div class="slds-col slds-size_12-of-12 slds-large-size_12-of-12">
                                    <p class="gc-default-color gc-tc-p-5 slds-p-top_x-small slds-p-bottom_x-small slds-m-bottom_none gc-tc-container-header">
                                        <strong>Agreement and Acceptance</strong>
                                    </p>
                                </div>
                                <div class="slds-col slds-size_12-of-12 slds-large-size_12-of-12  slds-p-left_large slds-p-right_large slds-p-top_x-small slds-p-bottom_x-small">
                                    
                                    <div class="slds-form-element__control slds-grow">
                                        <span class="slds-checkbox" part="input-checkbox">
                                            <input type="checkbox" checked="{!v.tc.tc1}" onchange="{!c.mobileCheckTC1}" part="checkbox" aura:id="gcCheckBox" required="true" id="m-checkbox-1" name="input1" value=""/>
                                            
                                            <label class="slds-checkbox__label" for="m-checkbox-1" part="label-container">
                                                <span part="indicator" class="slds-checkbox_faux"></span>
                                                <span class="slds-form-element__label" part="label">
                                                    <span class="gc-color-required">*</span>I acknowledge that I have read and agree to the terms set out in the 
                                                    <a href="{!$Resource.GigaCommSFOA}" target="_blank">standard form of agreement</a>, 
                                                    the offer terms set out above and the <a href="critical-information-summaries" target="_blank">
                                                    critical information summary</a> for my plan.
                                                </span>
                                            </label>
                                        </span>
                                    </div>
                                    
                                    <div class="slds-form-element__control slds-grow slds-m-top_small">
                                        <span class="slds-checkbox" part="input-checkbox">
                                            <input type="checkbox"  part="checkbox" checked="{!v.tc.tc2}" onchange="{!c.mobileCheckTC2}" aura:id="gcCheckBox" required="true" id="m-checkbox-2" name="input2" value=""/>
                                            <label class="slds-checkbox__label" for="m-checkbox-2" part="label-container">
                                                <span part="indicator" class="slds-checkbox_faux"></span>
                                                <span class="slds-form-element__label" part="label">
                                                    <!-- I acknowledge that I have read and agree to the terms set out in the <a href="#">standard form of agreement</a>,
                                                the offer terms set out above and the critical information summary for my plan. -->
                                                    <span class="gc-color-required">*</span><aura:unescapedHtml value="{!$Label.c.GigacommPersonalDetail_T_C_2}"/>
                                                </span>
                                            </label>
                                        </span>
                                    </div>
                                    
                                    <aura:if isTrue="{!v.lead.PlanSelected.Product_bric__r.Installer_Access_Required_bric__c}">
                                        <div class="slds-form-element__control slds-grow slds-m-top_small">
                                            <span class="slds-checkbox" part="input-checkbox">
                                                <input type="checkbox"  part="checkbox" checked="{!v.tc.tc3}" onchange="{!c.mobileCheckTC3}" aura:id="gcCheckBox" required="true" id="m-checkbox-3" name="input3" value=""/>
                                                <label class="slds-checkbox__label" for="m-checkbox-3" part="label-container">
                                                    <span part="indicator" class="slds-checkbox_faux"></span>
                                                    <span class="slds-form-element__label" part="label">
                                                        <span class="gc-color-required">*</span>{!$Label.c.GigacommPersonalDetail_T_C_3}
                                                    </span>
                                                </label>
                                            </span>
                                        </div>
                                    </aura:if>
                                    
                                    
                                    <div class="slds-form-element__control slds-grow slds-m-top_small">
                                        <label class="slds-checkbox__label" for="checkbox-3" part="label-container">
                                            <span class="slds-form-element__label" part="label">
                                                NOTE: <span style="color:red">*</span> These are mandatory fields
                                            </span>
                                        </label>
                                        
                                    </div>
                                    
                                    
                                    
                                    <p class="gc-default-color gc-tc-p-5"><br/><strong>Privacy Acknowledgment</strong></p>
                                    
                                    <div class="slds-form-element__control slds-grow slds-m-top_small">
                                        <span class="slds-checkbox" part="input-checkbox">
                                            <input type="checkbox"  part="checkbox" checked="{!v.tc.tc4}" onchange="{!c.mobileCheckTC4}" aura:id="gcCheckBox" id="m-checkbox-4" name="input4" value=""/>
                                            <label class="slds-checkbox__label" for="m-checkbox-4" part="label-container">
                                                <span part="indicator" class="slds-checkbox_faux"></span>
                                                <span class="slds-form-element__label" part="label">
                                                    <!--  [1]   &nbsp;<aura:unescapedHtml value="{!$Label.c.GigacommPersonalDetail_Privacy_Acknowledgment}"/> -->
                                                    I agree to receive marketing or promotional communications from GigaComm in accordance with the <a href="{!$Resource.GigacommPrivacyPolicy}" target="_blank">Privacy Policy</a>.
                                                </span>
                                            </label>
                                        </span>
                                    </div>
                                    
                                    <div class="slds-form-element__control slds-grow slds-m-top_small">
                                        <span class="slds-checkbox">
                                            <label class="slds-checkbox__label">
                                                <span class="slds-form-element__label" part="label">
                                                    GigaComm is committed to protecting and respecting your privacy, and we'll only
                                                    use your personal information to provide information you have requested, administer your account and
                                                    deliver our products and services.
                                                </span>
                                            </label>
                                        </span>
                                    </div>
                                    
                                    <div class="slds-text-align_center slds-m-top_large">
                                        <button class="slds-button " >
                                            
                                            <p class="slds-text-align_center gc-btn-neutral-border">
                                                <div class="slds-form-element__control slds-grow">
                                                    <span class="slds-checkbox" part="input-checkbox">
                                                        <input type="checkbox" part="checkbox" aura:id="selectAll" id="m-selectAll" name="selectAll" onchange="{!c.selectAllTerms}"/>
                                                        <label class="slds-checkbox__label" for="m-selectAll" part="label-container">
                                                            <span part="indicator" class="slds-checkbox_faux"></span>
                                                            
                                                            &nbsp;Select All
                                                            
                                                        </label>
                                                    </span>
                                                </div>  
                                            </p>
                                            
                                        </button>
                                        <!--[7] CL 6 Jun 2025 - Fix mobile TC Button-->
                                        <aura:if isTrue="{!v.acceptedTC}">
                                            <button class="slds-button gc-check-eligibility-btn" onclick="{!c.termsConditionsAccepted}">Accept T&amp;C's</button> <!-- [6] JPS 31 May 2025 - Add boolean var and onclick function to Accept T&Cs button -->
                                            
                                            <aura:set attribute="else">
                                                <button class="slds-button gc-check-eligibility-btn gc-btn-disabled" disabled="true">Accept T&amp;C's</button>
                                            </aura:set>
                                        </aura:if>
                                        
                                        
                                        
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </aura:if>
                <!--MOBILE TC END-->
                
            </div>
            <div class="slds-col slds-large-size_4-of-12 slds-small-size_12-of-12  slds-m-top_medium">
                <c:GigaCommPersonDetailsOrderSummary lead="{!v.lead}" />
                
                
                
                
                
                <div class="slds-grid slds-wrap slds-m-top_small" id="PlaceOrderSection">       
                    <div class="slds-col slds-size_12-of-12 slds-size-large_12-of-12">
                        <p class="gc-TC slds-p-around_small  slds-show_small">IMPORTANT <a href="#" data-bs-toggle="collapse" data-bs-target="#collapseAddress" >Click here</a> to review our T&amp;Cs</p> <!-- [2] -->
                        <aura:if isTrue="{!AND(v.confirmedDetails, v.enableBtn)}"> <!-- [5] JPS 31 May 2025 - Update conditional logic to enable "Place Order" button -->
                        <button class="btn gc-check-eligibility-btn form-control" value="placeOrder" onclick="{!c.validateForm}">Place Order</button>
                            
                            <aura:set attribute="else">
                                <button class="btn gc-check-eligibility-btn form-control gc-btn-disabled" disabled="true">Place order</button>
                            </aura:set>
                        </aura:if>
                        
                    </div>
                </div>
                
            </div>
        </div>
    </div>
    
    <div class="collapse"  id="collapseAddress">
        <section role="dialog" tabindex="-1" aria-modal="true" aria-labelledby="modal-heading-01" class="slds-modal slds-fade-in-open slds-modal_small ">
            <div class="slds-modal__container">
                
                <div class="slds-modal__content slds-p-around_large" id="modal-content-id-1">
                    
                    
                    <div class="slds-grid slds-wrap slds-m-bottom_small">       
                        <div class="slds-col slds-size_10-of-12 slds-large-size_10-of-12">
                            <h5 class="gc-default-color">Terms &amp; Conditions</h5>
                            
                        </div>
                        
                        <div class="slds-col slds-size_2-of-12 slds-large-size_2-of-12 slds-text-align_right">
                            <i class="fa fa-times" aria-hidden="true" data-bs-toggle="collapse" data-bs-target="#collapseAddress"></i>
                            
                        </div>
                        
                    </div>
                    
                    <div class="slds-grid slds-wrap gc-tc-container "> 
                        <div class="slds-col slds-size_12-of-12 slds-large-size_12-of-12">
                            <p class="gc-default-color gc-tc-p-5 slds-p-left_large slds-p-right_large slds-p-top_x-small slds-p-bottom_x-small gc-tc-container-header"><strong>Agreement and Acceptance</strong></p>
                        </div>
                        <div class="slds-col slds-size_12-of-12 slds-large-size_12-of-12  slds-p-left_large slds-p-right_large slds-p-top_x-small slds-p-bottom_x-small">
                            
                            <div class="slds-form-element__control slds-grow">
                                <span class="slds-checkbox" part="input-checkbox">
                                    <input type="checkbox" checked="{!v.tc.tc1}" onchange="{!c.mobileCheckTC1}" part="checkbox" aura:id="gcCheckBox" required="true" id="checkbox-1" name="input1" value=""/>
                                    
                                    <label class="slds-checkbox__label" for="checkbox-1" part="label-container">
                                        <span part="indicator" class="slds-checkbox_faux"></span>
                                        <span class="slds-form-element__label" part="label">
                                            <!-- I agree that GigaComm's <a href="#">standard form of agreement</a>, the offer terms set out above and the 
                                                critical information summary for my plan, form my agreement with GigaComm. -->
                                          <!--[1]  &nbsp;<aura:unescapedHtml value="{!$Label.c.GigacommPersonalDetail_T_C_1}"/> -->
                                            <span class="gc-color-required">*</span>I acknowledge that I have read and agree to the terms set out in the 
                                            <a href="{!$Resource.GigaCommSFOA}" target="_blank">standard form of agreement</a>, 
                                            the offer terms set out above and the <a href="critical-information-summaries" target="_blank">
                                            critical information summary</a> for my plan.
                                        </span>
                                    </label>
                                </span>
                            </div>
                            
                            <div class="slds-form-element__control slds-grow slds-m-top_small">
                                <span class="slds-checkbox" part="input-checkbox">
                                    <input type="checkbox" checked="{!v.tc.tc2}" onchange="{!c.mobileCheckTC2}" part="checkbox" aura:id="gcCheckBox" required="true" id="checkbox-2" name="input2" value=""/>
                                    <label class="slds-checkbox__label" for="checkbox-2" part="label-container">
                                        <span part="indicator" class="slds-checkbox_faux"></span>
                                        <span class="slds-form-element__label" part="label">
                                            <!-- I acknowledge that I have read and agree to the terms set out in the <a href="#">standard form of agreement</a>,
                                                the offer terms set out above and the critical information summary for my plan. -->
                                            <span class="gc-color-required">*</span><aura:unescapedHtml value="{!$Label.c.GigacommPersonalDetail_T_C_2}"/>
                                        </span>
                                    </label>
                                </span>
                            </div>
                            
                            <aura:if isTrue="{!v.lead.PlanSelected.Product_bric__r.Installer_Access_Required_bric__c}">
                            <div class="slds-form-element__control slds-grow slds-m-top_small">
                                <span class="slds-checkbox" part="input-checkbox">
                                    <input type="checkbox" checked="{!v.tc.tc3}" onchange="{!c.mobileCheckTC3}" part="checkbox" aura:id="gcCheckBox" required="true" id="checkbox-3" name="input3" value=""/>
                                    <label class="slds-checkbox__label" for="checkbox-3" part="label-container">
                                        <span part="indicator" class="slds-checkbox_faux"></span>
                                        <span class="slds-form-element__label" part="label">
                                            <span class="gc-color-required">*</span>{!$Label.c.GigacommPersonalDetail_T_C_3}
                                        </span>
                                    </label>
                                </span>
                            </div>
                            </aura:if>
                            
                            <!--aura:if isTrue="{!v.lead.VoucherTCs != null}">
                                <aura:iteration items="{!v.lead.VoucherTCs}" var="item" indexVar="index">
                                    <aura:if isTrue="{!item.Has_T_C_bric__c}">
                                        <p class="gc-default-color gc-tc-p-5"><br/><strong>Promo Voucher</strong></p>   
                                        <div class="slds-form-element__control slds-grow slds-m-top_small">
                                            <span class="slds-checkbox" part="input-checkbox">
                                                <input type="checkbox" checked="{!v.tc.tc5}" onchange="{!c.mobileCheckTC5}" part="checkbox" aura:id="gcCheckBox" required="true" id="checkbox-5" name="input3" value=""/>
                                                <label class="slds-checkbox__label" for="checkbox-5" part="label-container">
                                                    <span part="indicator" class="slds-checkbox_faux"></span>
                                                    <span class="slds-form-element__label" part="label">
                                                        <span class="gc-color-required">*</span>{!item.Voucher_T_C__c}
                                                    </span>
                                                </label>
                                            </span>
                                        </div>
                                    </aura:if>                                    
                                    
                                </aura:iteration>
                            </aura:if-->
                            
                            
                            
                            
                            <div class="slds-form-element__control slds-grow slds-m-top_small">
                                     <label class="slds-checkbox__label" for="checkbox-3" part="label-container">
                                        <span class="slds-form-element__label" part="label">
                                            NOTE: <span style="color:red">*</span> These are mandatory fields
                                        </span>
                                    </label>
                              
                            </div>
                            
                            
                            
                            <p class="gc-default-color gc-tc-p-5"><br/><strong>Privacy Acknowledgment</strong></p>
                            
                            <div class="slds-form-element__control slds-grow slds-m-top_small">
                                <span class="slds-checkbox" part="input-checkbox">
                                    <input type="checkbox" checked="{!v.tc.tc4}" onchange="{!c.mobileCheckTC4}" part="checkbox" aura:id="gcCheckBox" id="checkbox-4" name="input4"/>
                                    <label class="slds-checkbox__label" for="checkbox-4" part="label-container">
                                        <span part="indicator" class="slds-checkbox_faux"></span>
                                        <span class="slds-form-element__label" part="label">
                                       <!--  [1]   &nbsp;<aura:unescapedHtml value="{!$Label.c.GigacommPersonalDetail_Privacy_Acknowledgment}"/> -->
                                            I agree to receive marketing or promotional communications from GigaComm in accordance with the <a href="{!$Resource.GigacommPrivacyPolicy}" target="_blank">Privacy Policy</a>.
                                        </span>
                                    </label>
                                </span>
                            </div>
                            
                            <div class="slds-form-element__control slds-grow slds-m-top_small">
                                <span class="slds-checkbox">
                                    <label class="slds-checkbox__label">
                                        <span class="slds-form-element__label" part="label">
                                            GigaComm is committed to protecting and respecting your privacy, and we'll only
                                            use your personal information to provide information you have requested, administer your account and
                                            deliver our products and services.
                                        </span>
                                    </label>
                                </span>
                            </div>
                            
                            
                      
                            
                            
                            
                        </div>
                        
                        <div class="slds-col slds-size_6-of-12 slds-p-around_medium">
                            <button class="slds-button " >
                                
                                <p class="slds-text-align_center gc-btn-neutral-border gc-pd-btn-size">
                                    <div class="slds-form-element__control slds-grow">
                                        <span class="slds-checkbox" part="input-checkbox">
                                            <input type="checkbox" part="checkbox" aura:id="selectAll" id="selectAll" name="selectAll" onchange="{!c.selectAllTerms}"/>
                                            <label class="slds-checkbox__label" for="selectAll" part="label-container">
                                                <span part="indicator" class="slds-checkbox_faux"></span>
                                                
                                                &nbsp;Select All
                                                
                                            </label>
                                        </span>
                                    </div>  
                                </p>
                                
                            </button>
                        </div>
                        <div class="slds-col slds-size_6-of-12 slds-p-around_medium ">
                            <p class="slds-text-align_right">
                            <aura:if isTrue="{!v.acceptedTC}">
                                <button class="slds-button gc-check-eligibility-btn gc-pd-btn-size"  data-bs-toggle="collapse" data-bs-target="#collapseAddress" onclick="{!c.termsConditionsAccepted}">Accept T&amp;C's</button> <!-- [6] JPS 31 May 2025 - Add boolean var and onclick function to Accept T&Cs button -->
                                
                                <aura:set attribute="else">
                                    <button class="slds-button gc-check-eligibility-btn gc-btn-disabled gc-pd-btn-size" disabled="true">Accept T&amp;C's</button>
                                </aura:set>
                            </aura:if>
                                </p>
                        </div>
                    </div>
                    
                    
                    
                </div>
             
            </div>
        </section>
        <div class="slds-backdrop slds-backdrop_open" role="presentation"></div>
    </div>
    
    
    
    <aura:if isTrue="{!v.showSpinner}">
        <div class="exampleHolder">
            <lightning:spinner alternativeText="Loading" size="large" />
        </div>
    </aura:if>
    
    
    <aura:if isTrue="{!v.apiHasError}">
        <div class="show"  id="unavailableServiceId">
            
            <c:GigacommServiceUnavailable />    
        </div>
    </aura:if>
    
    <aura:if isTrue="{!v.showPromoModal}">
        <div class="show"  id="applyPromoModal">
            <c:GigacommPromoModal />    
        </div>
    </aura:if>
    
    
    
</aura:component>