<aura:component extends="forceCommunity:navigationMenuBase" access="global" >
    <aura:attribute name="navigationLinkSetId" type="String" default="GigaComm_Footer_Navigation" />
    <nav class="" role="navigation">
        <ul class="gc-footer-nav" onclick="{!c.onClick}">
            
            <aura:iteration items="{!v.menuItems}" var="item">
                <aura:if isTrue="{!item.label != 'Home'}">
                    <li class="">
                        <a href="#" class="{!item.active ? 'gc-is-active ' : ''}" title="gc-menu">
                            <a href="javascript:void(0);" data-menu-item-id="{!item.id}" class="gc-link">
                                {!item.label}
                            </a>
                        </a>
                    </li>
                </aura:if> 
            </aura:iteration>
        </ul>
    </nav>
    
</aura:component>