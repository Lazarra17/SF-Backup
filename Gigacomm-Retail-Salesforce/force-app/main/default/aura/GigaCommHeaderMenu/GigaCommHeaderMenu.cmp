<aura:component extends="forceCommunity:navigationMenuBase">
    <aura:attribute name="navigationLinkSetId" type="String" default="GigaComm_Navigation" />
    
    <ul class="navbar-nav me-auto mb-2 mb-lg-0" onclick="{!c.onClick}">
        <aura:iteration items="{!v.menuItems}" var="item">
            <aura:if isTrue="{!item.label != 'Home'}">
                <li class="nav-item">
                    <a href="javascript:void(0);" data-menu-item-id="{!item.id}" class="nav-link" title="gc-menu">
                        <aura:if isTrue="{!item.label == 'Deals'}">
                            <a href="javascript:void(0);" data-menu-item-id="{!item.id}" class="gc-link-deals">
                                <i class="fa fa-tag gc-shopping-mode" aria-hidden="true"></i> {!item.label}
                            </a>
                            <aura:set attribute="else">
                                <a href="javascript:void(0);" data-menu-item-id="{!item.id}" class="{!item.active ? 'gc-link-active' : 'gc-link'}">
                                    {!item.label}
                                </a>
                            </aura:set>
                        </aura:if>
                        
                    </a>
                </li>
            </aura:if> 
        </aura:iteration>
 
    </ul>
    <div class="d-flex">
        <p class="gc-contact">
            <span >
                <a href="tel:1300 004 442"><i class="fa fa-phone" aria-hidden="true"></i> 1300 004 442</a>
            </span>
        </p>
    </div>
</aura:component>