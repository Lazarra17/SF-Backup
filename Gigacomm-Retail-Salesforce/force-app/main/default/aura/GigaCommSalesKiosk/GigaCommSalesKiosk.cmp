<!--
[1] WM 28 May 2025 - Change "Sales Kiosk" to "Agent Portal"

-->
<aura:component  implements="force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" controller="GigaCommSalesKioskController">
    <aura:handler name="init" value="{!this}" action="c.doInit"/>
    <aura:attribute name="AgentCode" type="String" />
    <div class="slds-grid slds-wrap slds-m-top_large">
        <div class="slds-col slds-size_12-of-12 gc-plans-heading">
            <h4 class="gc-heading-title slds-m-top_medium">Agent Portal</h4>
            <!--p class="gc-success-text">Lorem ipsum is simply dummy text of the printing and industry</p-->
        </div>
    </div>
    
    <div class="container slds-m-top_xx-large gc-sales-kiosk">
        <div class="slds-grid slds-wrap ">
            <div class="slds-col slds-large-size_2-of-12 slds-size-small_12-of-12">
            </div>
            <div class="slds-col slds-large-size_8-of-12 slds-size-small_12-of-12">
                
                <p class="slds-m-top_medium gc-default-color slds-m-top_medium slds-m-bottom_medium gc-sales-kiosk-title"><strong>Welcome Back!</strong></p>
                <p>Please enter your agent code.</p>
                <div class="slds-grid slds-wrap slds-gutters gc-sales-kiosk-container slds-p-around_large">
                    
                
                    
                    <div class="slds-col slds-large-size_9-of-12 slds-size-small_9-of-12">
                        <lightning:input required="true" aura:id="agentCode" name="agentCode" type="text" class="gc-pd-input-text" label="Agent Code" placeholder="e.g GRF10" value="{!v.AgentCode}" pattern="GC[VNQSTWA]\d{2}" messageWhenPatternMismatch="Please check your username and try again."/>
                    </div>
                    
                    <div class="slds-col slds-large-size_3-of-12 slds-size-small_3-of-12 slds-m-top_large">
                        <button class="btn gc-check-eligibility-btn form-control" onclick="{!c.validateInput}">Next</button>
                    </div>
                </div>
              
                
            </div>
            
            <div class="slds-col slds-large-size_2-of-12 slds-size-small_12-of-12">
            </div>
            
        </div>
        
        
    </div>   
</aura:component>