<!--
[1] WM 20 May 2025 return URL
[2] CL - 17-June-25 - Update Lead Source

-->

<aura:component  implements="force:hasRecordId,forceCommunity:availableForAllPageTypes" access="global" controller="GigaCommAddressInterestController">  
    <aura:attribute name="lead" type="Object" />
    <aura:registerEvent name="cmpEvent" type="c:GigaCommOrderWizardEvent"/>
    <aura:attribute name="ipAddress" type="String" />
    <aura:handler name="init" value="{!this}" action="c.doInit"/>
    <section role="dialog" tabindex="-2" aria-modal="true" aria-labelledby="modal-heading-01" class="slds-modal slds-fade-in-open slds-modal_small ">
        <div class="slds-modal__container">
            
            <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                
                
                <div class="slds-grid slds-wrap	">
                    <div class="slds-col slds-size_6-of-12">
                    </div>
                    <div class="slds-col slds-size_6-of-12 slds-text-align_right">
                        <button class="slds-button slds-button_icon slds-modal__close" data-bs-toggle="collapse"  data-bs-target="#collapseRegisterAddress" >
                            <span class="material-symbols-outlined">
                                close
                            </span>
                            <span class="slds-assistive-text">Cancel and close</span>
                        </button>
                        
                        
                    </div>
                </div>
                
                <div class="container">
                    <div class="slds-grid slds-wrap slds-p-around_large">
                        <div class="slds-col slds-size-large_12-of-12 slds-size-small_12-of-12">
                            <div class="slds-text-align_center">
                                <img class="" src="{!$Resource.GigacommAddressInterest}" />
                                
                                <h1 class="gc-default-color slds-m-top_medium slds-m-bottom_medium">Sorry, Gigacomm is not in your area yet</h1>
                                <!-- <p class="gc-default-color"><strong>Welcome to the Gigacomm community.</strong></p> -->
                                <p class="slds-m-bottom_none">Sign up today and we'll get you covered as soon as possible</p>
                            </div>
                            <div class="slds-grid slds-grid_align-center slds-m-top_medium">
                                <div class="slds-theme_default">
                                    <div class="slds-grid slds-wrap slds-gutters slds-p-around_small">
                                        
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <lightning:input aura:id="addressField" name="FirstName" required="true" class="gc-pd-input-text" label="First Name" placeholder="Enter First name" value="{!v.lead.FirstName}"  />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <lightning:input aura:id="addressField" name="LastName" required="true" class="gc-pd-input-text" label="Last Name" placeholder="Enter Last name" value="{!v.lead.LastName}"  />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <lightning:input aura:id="addressField" name="email" required="true" type="email"  class="gc-pd-input-text slds-border-around_none" label="Email" value="{!v.lead.Email}"  placeholder="Enter Email" />
                                        </div>
                                        <div class="slds-col slds-small-size_1-of-1 slds-large-size_12-of-12">
                                            <lightning:input aura:id="addressField" name="Address" required="true" class="gc-pd-input-text" label="Address" placeholder="Enter Address" value="{!v.lead.Address}" />
                                        </div>
                                    </div>
                                   
                                    
                                    
                                        <div class="slds-form-element slds-text-align_center slds-m-top_medium">
                                            <button class="gc-btn gc-btn-success gc-default-color" data-bs-toggle="collapse"  data-bs-target="#collapseRegisterAddress"  onclick="{!c.validateForm}">Sign up today</button>
                                        </div>
                                    </div>
                                </div>
                                
                        
                            
                        </div>
                        
                    </div>
                    
                    
                </div>  
                
            </div>
        </div>
    </section>
    <div class="slds-backdrop slds-backdrop_open" role="presentation"></div>
    
</aura:component>