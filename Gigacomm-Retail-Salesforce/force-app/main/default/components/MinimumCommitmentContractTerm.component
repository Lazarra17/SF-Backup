<apex:component controller="MinimumCommitmentContractTermCtrl" access="global">

    <apex:attribute name="opportunityId" type="String" assignTo="{!oppId}" description="Opportunity Id"/>

    <div style="text-align:center; vertical-align:top; padding:2%;">
        The minimum commitment over the contract term is&nbsp;
        <apex:outputPanel rendered="{!minPrice < 0}">
            $0
        </apex:outputPanel>
        <apex:outputPanel rendered="{!minPrice >= 0}">
            <apex:outputText value="{0,number,¤#,##0.00;-¤#,##0.00}">
                <apex:param value="{!minPrice}" />
            </apex:outputText>
        </apex:outputPanel>
        <!-- <br/><br/><br/>
        This quote is valid for 30 days -->
    </div>
</apex:component>