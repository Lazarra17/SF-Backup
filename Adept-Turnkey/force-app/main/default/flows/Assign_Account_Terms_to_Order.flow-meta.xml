    <description>JPS 28 May - Update logic to populate payment terms from opp
JPS 21 May - Add logic to populate payment terms from opportunity</description>
    <environments>Default</environments>
    <formulas>
        <name>FormulaPaymentTermDay</name>
        <dataType>Number</dataType>
        <expression>IF(
 AND(
NOT(ISBLANK({!$Record.OpportunityId})),
    NOT(ISBLANK({!Opportunity.Id})),
    NOT(ISNULL({!Opportunity.nao__Payment_Term_Day_bric__c}))
 ),
 {!Opportunity.nao__Payment_Term_Day_bric__c},
 {!Get_Account.nao__Payment_Term_Day_Bric__c}
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>FormulaPaymentTermType</name>
        <dataType>String</dataType>
        <expression>IF(
 AND(
NOT(ISBLANK({!$Record.OpportunityId})),
    NOT(ISBLANK({!Opportunity.Id})),
    NOT(ISBLANK(TEXT({!Opportunity.Payment_Term_Type__c})))
 ),
 TEXT({!Opportunity.Payment_Term_Type__c}),
 TEXT({!Get_Account.nao__Payment_Term_Type_Bric__c})
)</expression>
    </formulas>
