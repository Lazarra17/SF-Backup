    <formulas>
        <name>forBackOrderQty</name>
        <dataType>Number</dataType>
        <expression>{!Loop_GRN_Items.nao__Order_Quantity__c} - {!Loop_GRN_Items.nao__Amount_Received__c}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>forShippingAddress</name>
        <dataType>String</dataType>
        <expression>IF({!Get_GRN.nao__Order_bric__r.ShippingStreet} != &apos;&apos; , {!Get_GRN.nao__Order_bric__r.ShippingStreet} + &apos;, &apos;  ,  &apos;&apos; ) + 
IF({!Get_GRN.nao__Order_bric__r.ShippingCity} != &apos;&apos; , {!Get_GRN.nao__Order_bric__r.ShippingCity} + &apos;, &apos;  ,  &apos;&apos; ) + 
IF({!Get_GRN.nao__Order_bric__r.ShippingState} != &apos;&apos; , {!Get_GRN.nao__Order_bric__r.ShippingState} + &apos;, &apos;  ,  &apos;&apos; ) + 
IF({!Get_GRN.nao__Order_bric__r.ShippingCountry} != &apos;&apos; , {!Get_GRN.nao__Order_bric__r.ShippingCountry} + &apos;, &apos;  ,  &apos;&apos; ) + 
IF({!Get_GRN.nao__Order_bric__r.ShippingPostalCode} != &apos;&apos; , {!Get_GRN.nao__Order_bric__r.ShippingPostalCode} ,  &apos;&apos; )</expression>
    </formulas>
    <formulas>
