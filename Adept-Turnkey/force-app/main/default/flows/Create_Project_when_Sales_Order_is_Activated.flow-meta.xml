<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>JPS 30 Oct 2025 - &quot;Created&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>FormulaProjectName</name>
        <dataType>String</dataType>
        <expression>IF(
  BEGINS({!Sales_Order.Opportunity.Name}, &quot;E&quot;), 
  &quot;K&quot; &amp; RIGHT({!Sales_Order.Opportunity.Name}, LEN({!Sales_Order.Opportunity.Name}) - 1), 
  {!Sales_Order.Opportunity.Name}
)</expression>
    </formulas>
    <interviewLabel>Create Project when Sales Order is Activated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Project when Sales Order is Activated</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Project</name>
        <label>Create Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>NewProjectId</assignRecordIdToReference>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>FormulaProjectName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Warehouse__c</field>
            <value>
                <elementReference>Sales_Order.nao__Inventory_Location__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>nao__Account__c</field>
            <value>
                <elementReference>Sales_Order.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>nao__Opportunity__c</field>
            <value>
                <elementReference>Sales_Order.OpportunityId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>nao__Project_End_bric__c</field>
            <value>
                <elementReference>Sales_Order.EndDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>nao__Project_Start_bric__c</field>
            <value>
                <elementReference>Sales_Order.EffectiveDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>nao__Status_bric__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>nao__Project__c</object>
    </recordCreates>
    <recordLookups>
        <name>Sales_Order</name>
        <label>Sales Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Project</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Sales_Order</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>NewProjectId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
