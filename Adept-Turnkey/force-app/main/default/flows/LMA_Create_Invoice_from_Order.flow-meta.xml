    <environments>Default</environments>
    <formulas>
        <name>FormulaDepositAmount</name>
        <dataType>Currency</dataType>
        <expression>{!FormulaDepositPercentage} * {!Order_Get.TotalAmount}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaDepositPercentage</name>
        <dataType>Number</dataType>
        <expression>{!InvoicePercentage} / 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaInvoiceLineAmount</name>
        <dataType>Currency</dataType>
        <expression>IF({!InvoiceType} == &apos;Final&apos;, {!Order_Products_Loop.TotalPrice}, {!FormulaInvQuantity} * {!Order_Products_Loop.UnitPrice})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaInvQuantity</name>
        <dataType>Number</dataType>
        <expression>IF({!InvoiceType} == &apos;Final&apos;, {!Order_Products_Loop.Quantity}, {!Order_Products_Loop.Quantity} * ({!InvoicePercentage} / 100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormulaPaidDate</name>
        <dataType>String</dataType>
        <expression>TEXT(DAY({!Deposit_Invoice_Loop.Paid_Date_Bric__c})) &amp; &quot; &quot; &amp;
CASE(
  MONTH({!Deposit_Invoice_Loop.Paid_Date_Bric__c}),
  1, &quot;Jan&quot;,
  2, &quot;Feb&quot;,
  3, &quot;Mar&quot;,
  4, &quot;Apr&quot;,
  5, &quot;May&quot;,
  6, &quot;Jun&quot;,
  7, &quot;Jul&quot;,
  8, &quot;Aug&quot;,
  9, &quot;Sep&quot;,
  10, &quot;Oct&quot;,
  11, &quot;Nov&quot;,
  12, &quot;Dec&quot;,
  &quot;&quot;
) &amp; &quot; &quot; &amp;
TEXT(YEAR({!Deposit_Invoice_Loop.Paid_Date_Bric__c}))</expression>
    </formulas>
    <formulas>
        <name>formulaToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>FormulaTotalAmtPaid</name>
        <dataType>Currency</dataType>
        <expression>-1 * {!Deposit_Invoice_Loop.nao__Amount_Paid__c}</expression>
        <scale>2</scale>
    </formulas>
