    <environments>Default</environments>
    <formulas>
        <name>formulaDateTodayText</name>
        <dataType>String</dataType>
        <expression>RIGHT(TEXT(Today()),2) + &apos;-&apos; + MID(TEXT(Today()), 6, 2) + &apos;-&apos; + LEFT(TEXT(Today()),4)</expression>
    </formulas>
    <formulas>
        <name>formulaDueDate</name>
        <dataType>Date</dataType>
        <expression>IF(len(text({!Order_Get.nao__Payment_Term_Day_bric__c}))=0,TODAY(),TODAY() + {!Order_Get.nao__Payment_Term_Day_bric__c})</expression>
    </formulas>
    <formulas>
        <name>formulaInvoiceEmailBody</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Get_Invoice_Email_Template.HtmlValue}, &apos;$DATE_TODAY&apos;, {!formulaDateTodayText})</expression>
    </formulas>
    <formulas>
        <name>formulaInvoiceEmailSubject</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE({!Get_Invoice_Email_Template.Subject}, &apos;$ORDER_NUMBER&apos;, {!Order_Get.OrderNumber})</expression>
    </formulas>
    <formulas>
        <name>formulaLineTotal</name>
        <dataType>Currency</dataType>
        <expression>{!Order_Pick_Lines_Loop.nao__Picked_Quantity__c} * {!Order_Pick_Lines_Loop.Order_Product__r.UnitPrice}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>formulaToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
