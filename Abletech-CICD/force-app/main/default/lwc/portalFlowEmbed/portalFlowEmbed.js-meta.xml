<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Portal Flow Embed</masterLabel>
    <description>Embeds a Screen Flow and refreshes list views when the flow finishes.</description>

    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="flowApiName" type="String" label="Flow API Name" required="true"
                      description="API name of the Screen Flow to run (e.g., Order_Portal_New_Order)" />
            <property name="flowArguments" type="String" label="Flow Input Variables (JSON)"
                      description='Optional JSON array, e.g. [{"name":"recordId","type":"String","value":"001..."}]' />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>